# Copy to .env (git-ignored) and fill in
DB_USER=assistant
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# At least 32 characters
JWT_SECRET=
# AI recipe suggestions (optional). Get a key at https://aistudio.google.com/apikey
# See docs/AI_SETUP.md. AI_PROVIDER=demo tries the flow with made-up recipes and no key.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# AI_PROVIDER=auto
# AI_DAILY_LIMIT=20
# Push notifications (optional). Path to the Firebase service-account key, kept OUTSIDE the repo.
# See docs/FIREBASE_SETUP.md
# FIREBASE_CREDENTIALS_FILE=
